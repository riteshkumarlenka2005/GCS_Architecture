      "id": "node-cop04-playback-data",
      "label": "Historical Data Retriever",
      "type": "component",
      "engineId": "eng-cop-historical-playback",
      "description": "Retrieves historical vehicle positions, telemetry, and mission events from the Data Persistence Engine for a requested time window. Supports pre-fetching of upcoming data segments to ensure smooth playback, caches recently accessed time windows in memory, and handles data gaps by interpolating between known positions or flagging discontinuities to the Playback Controller.",
      "position": {
        "x": 120,
        "y": 380
      },
      "size": {
        "width": 230,
        "height": 150
      },
      "style": {
        "backgroundColor": "#1a1a3e",
        "borderColor": "#8b5cf6",
        "borderWidth": 2,

          "id": "port-cop04-pd-in-query",
          "label": "Time Window Query",
          "direction": "in",
          "dataType": "control",
          "position": "top"
        },
        {
          "id": "port-cop04-pd-out-data",
          "label": "Historical Data Out",
          "direction": "out",
          "dataType": "data",
          "position": "top"
        },
        {
          "id": "port-cop04-pd-in-data",

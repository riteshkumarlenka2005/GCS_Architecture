          "label": "Active Overlay Defs",
          "direction": "out",
          "dataType": "data",
          "position": "right"
        },
        {
          "id": "port-cop04-om-out-persist",
          "label": "Persist Overlay Definitions",
          "direction": "out",
          "dataType": "data",
          "position": "bottom"
        },
        {
          "id": "port-cop04-om-in-load",

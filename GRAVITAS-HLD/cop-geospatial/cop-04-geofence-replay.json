  "nodes": [
    {
      "id": "node-cop04-playback-ctrl",
      "label": "Playback Controller",
      "type": "component",
      "engineId": "eng-cop-historical-playback",
      "description": "Manages the historical mission playback timeline: play, pause, scrub, speed control (0.25x–16x), and jump-to-timestamp. Coordinates with the Historical Data Retriever to load time-windowed data segments, injects historical vehicle positions and telemetry into the COP Orchestrator as if they were live data, synchronizes playback state across all COP layers (tracks, geofences, obstacles), and publishes playback lifecycle events to the Core Event Bus.",
      "position": {
        "x": 120,
        "y": 120
      },
      "size": {
        "width": 240,
        "height": 170
      },
      "style": {
        "backgroundColor": "#1a1a3e",
        "borderColor": "#8b5cf6",
        "borderWidth": 2,
        "borderStyle": "solid",
        "cornerRadius": 8,
        "textColor": "#e2e8f0",
        "fontSize": 13,
        "icon": "clock-rotate-left"
      },
      "ports": [
        {
          "id": "port-cop04-pc-in-data",
          "label": "Historical Data In",
          "direction": "in",
          "dataType": "data",
          "position": "left"
        },
        {
          "id": "port-cop04-pc-out-inject",
          "label": "Inject Positions",
          "direction": "out",
          "dataType": "data",
          "position": "right"
        },
        {
          "id": "port-cop04-pc-out-events",
          "label": "Playback Events",
          "direction": "out",
          "dataType": "event",
          "position": "bottom"
        },
        {
          "id": "port-cop04-pc-out-query",

  "assumptions": [
    {
      "id": "AS-034",
      "description": "Historical playback data is available in the Data Persistence Engine with sufficient temporal resolution for smooth playback at the maximum supported speed (16x).",
      "rationale": "Playback smoothness depends on data density; the Historical Data Retriever interpolates gaps but cannot create data that was never recorded."
    },
    {
      "id": "AS-035",
      "description": "Fused observation events arriving via the Core Event Bus include spatial coordinates, temporal stamps, confidence scores, and source identifiers as defined by the Sensor Fusion engine contract.",
      "rationale": "Data Fusion Visualizer is a consumer of fused observations; the event schema is an upstream contract."
    },
    {
      "id": "AS-036",
      "description": "Overlay configuration definitions are stored as structured documents (e.g., JSON) within the Data Persistence Engine and can be shared between operators via import/export.",
      "rationale": "Overlay configurations are user-generated content that must survive restarts and be portable across GCS instances."
    },
    {
      "id": "AS-037",
      "description": "Offline tile packages conform to a standard tile package format (e.g., MBTiles, TPK) and the specific format support is an implementation detail.",
      "rationale": "Tile package formats are well-standardized; the Offline Tile Store abstracts format differences behind a uniform tile lookup interface."
    },
    {
      "id": "AS-038",
      "description": "The transition between online and offline map serving modes is automatic based on network connectivity detection, with manual override available to the operator.",
      "rationale": "Operators in field environments may lose connectivity unexpectedly; automatic fallback ensures map continuity."
    }
  ],
  "unresolvedDecisions": [
    {
      "id": "UD-038",
      "description": "Maximum supported playback speed and the data pre-fetch window size for smooth high-speed playback.",
      "impact": "Affects Historical Data Retriever's memory usage and pre-fetch strategy.",
      "owner": "Performance Architecture"
    },
    {
      "id": "UD-039",
      "description": "Data fusion visualization update rate and the maximum number of concurrent fused observations displayed.",
      "impact": "Affects Data Fusion Visualizer's rendering performance and the Spatial Query Service's query load.",
      "owner": "Performance Architecture"
    },
    {
      "id": "UD-040",
      "description": "Overlay expression language and filter syntax for configurable overlay data bindings.",
      "impact": "Affects Overlay Configuration Manager's parser complexity and Overlay Renderer's evaluation performance.",
      "owner": "Customization Architecture"
    },
    {
      "id": "UD-041",
      "description": "Offline tile storage quota default and eviction policy (LRU, by zoom level, by geographic region).",
      "impact": "Affects Offline Tile Store's storage management and the operator's offline map coverage.",
      "owner": "Deployment Architecture"
    }
  ],

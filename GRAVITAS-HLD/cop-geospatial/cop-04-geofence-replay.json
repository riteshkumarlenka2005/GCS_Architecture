    {
      "id": "node-cop04-fusion-viz",
      "label": "Data Fusion Visualizer",
      "type": "component",
      "engineId": "eng-cop-data-fusion-viz",
      "description": "Visualizes fused multi-source sensor observations and intelligence data on the operational picture. Ingests fused observation events from the Core Event Bus (originating from the Sensor Fusion engine), performs spatial and temporal correlation using the Spatial Query Service to cluster related detections, applies confidence-weighted symbology, and renders composite situational awareness overlays to the Map Renderer. Supports configurable fusion display modes including heat maps, confidence ellipses, and track correlation indicators.",
      "position": {
        "x": 520,
        "y": 120
      },
      "size": {
        "width": 240,
        "height": 170
      },
      "style": {
        "backgroundColor": "#0e3a2e",
        "borderColor": "#10b981",
        "borderWidth": 2,
        "borderStyle": "solid",
        "cornerRadius": 8,
        "textColor": "#e2e8f0",
        "fontSize": 13,
        "icon": "layer-group"
      },
      "ports": [
        {
          "id": "port-cop04-fv-in-obs",
          "label": "Fused Observations",
          "direction": "in",
          "dataType": "event",
          "position": "top"
        },
        {
          "id": "port-cop04-fv-out-query",
          "label": "Correlation Query",
          "direction": "out",
          "dataType": "data",
          "position": "bottom"
        },
        {
          "id": "port-cop04-fv-in-query-res",
          "label": "Correlation Result",
          "direction": "in",
          "dataType": "data",
          "position": "bottom"
        },
        {
          "id": "port-cop04-fv-out-layer",

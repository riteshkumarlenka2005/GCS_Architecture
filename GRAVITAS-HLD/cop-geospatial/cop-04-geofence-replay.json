    {
      "id": "node-cop04-overlay-renderer",
      "label": "Overlay Renderer",
      "type": "component",
      "engineId": "eng-cop-configurable-overlays",
      "description": "Evaluates active overlay configurations against current data sources and produces styled map overlay layers. Binds overlay data sources to live vehicle state, historical data, geofence status, and sensor observations. Applies filter expressions and symbology rules from the Overlay Configuration Manager, handles conditional display logic (e.g., show only when zoomed in, show only for selected vehicles), and outputs the composed overlay layers to the Map Renderer.",
      "position": {
        "x": 880,
        "y": 420
      },
      "size": {
        "width": 230,
        "height": 160
      },
      "style": {

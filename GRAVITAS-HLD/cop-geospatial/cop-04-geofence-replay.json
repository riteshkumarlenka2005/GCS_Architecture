    },
    {
      "id": "node-cop04-overlay-mgr",
      "label": "Overlay Configuration Manager",
      "type": "component",
      "engineId": "eng-cop-configurable-overlays",
      "description": "Manages user-defined overlay configurations including data source bindings, filter expressions, symbology rules, and display conditions. Supports CRUD operations on overlay definitions, import/export of overlay configuration packages, and template-based overlay creation for common mission types. Pushes the active overlay configuration set to the Overlay Renderer for evaluation and display.",
      "position": {
        "x": 520,
        "y": 420
      },
      "size": {
        "width": 240,
        "height": 160
      },
      "style": {
        "backgroundColor": "#0e3a2e",
        "borderColor": "#10b981",
        "borderWidth": 2,

  "assumptions": [
    {
      "id": "AS-026",
      "description": "Terrain elevation data sources provide data in standard DEM formats (e.g., GeoTIFF, HGT) accessible via tile-based or file-based interfaces.",
      "rationale": "DEM formats are well-standardized in the geospatial community; the Terrain Data Source abstracts format differences."
    },
    {
      "id": "AS-027",
      "description": "Track recording sampling rate is configurable per vehicle and defaults to a rate that balances track fidelity with storage efficiency.",
      "rationale": "High-frequency position data (e.g., 50 Hz) would produce excessive track data; downsampling is necessary for display purposes."
    },
    {
      "id": "AS-028",
      "description": "The Terrain Tile Cache and Track Data Store use the Data Persistence Engine as their underlying storage backend but maintain separate namespaces and retention policies.",
      "rationale": "Terrain tiles and track data have different access patterns, sizes, and lifecycle requirements."
    },
    {
      "id": "AS-029",
      "description": "Track data retention is governed by a configurable policy (e.g., maximum age, maximum storage size) enforced by the Track Data Store.",
      "rationale": "Unbounded track accumulation would eventually exhaust storage; retention must be mission-configurable."
    }
  ],

  "assumptions": [
    {
      "id": "AS-030",
      "description": "Geofence evaluation runs at a rate commensurate with vehicle position update frequency (typically 1–10 Hz) and is optimized for the number of active geofences and vehicles.",
      "rationale": "Evaluation latency must be low enough to provide timely alerts before boundary breach; performance depends on geofence complexity."
    },
    {
      "id": "AS-031",
      "description": "Dynamic obstacle reports arriving via the event bus include position, type, confidence, and timestamp fields; the specific report schema is defined by the sensor subsystem.",
      "rationale": "Obstacle Tracker is a consumer of obstacle events; the report format is an upstream contract."
    },
    {
      "id": "AS-032",
      "description": "The Spatial Query Service uses an in-memory spatial index (e.g., R-tree) for fast query performance, with the index rebuilt from persistent sources on GCS restart.",
      "rationale": "Spatial queries must be fast for real-time geofence evaluation; the index is a derived structure that can be reconstructed."
    },
    {
      "id": "AS-033",
      "description": "Geospatial data import supports files up to a configurable size limit, with large datasets processed incrementally to avoid blocking the UI.",
      "rationale": "Large geospatial files (e.g., high-resolution terrain contours) could stall the application if loaded synchronously."
    }
  ],
  "unresolvedDecisions": [
    {
      "id": "UD-034",
      "description": "Specific geofence geometry complexity limits (maximum vertex count per polygon, maximum corridor segment count) and their impact on evaluation performance.",
      "impact": "Affects Geofence Evaluator's real-time performance guarantees and Spatial Query Service's index sizing.",
      "owner": "Geospatial Architecture"
    },
    {
      "id": "UD-035",
      "description": "Dynamic obstacle TTL default values and confidence decay function parameters per obstacle source type.",
      "impact": "Affects Obstacle Tracker's active obstacle list size and the freshness of displayed obstacle information.",
      "owner": "Operations Architecture"
    },

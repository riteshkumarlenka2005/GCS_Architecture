    {
      "id": "node-cop03-obstacle-tracker",
      "label": "Obstacle Tracker",
      "type": "component",
      "engineId": "eng-cop-dynamic-obstacles",
      "description": "Ingests dynamic obstacle reports from multiple sources (sensor detections via the event bus, manual operator annotations, external threat feeds) and maintains a time-stamped active obstacle list. Applies configurable time-to-live (TTL) and confidence decay to each obstacle, merges duplicate reports for the same physical obstacle, and pushes the current active obstacle set to the Obstacle Renderer for display.",
      "position": {
        "x": 860,
        "y": 120
      },
      "size": {
        "width": 230,
        "height": 160
      },
      "style": {
        "backgroundColor": "#2a2210",
        "borderColor": "#f59e0b",
        "borderWidth": 2,
        "borderStyle": "solid",
        "cornerRadius": 8,
        "textColor": "#e2e8f0",
        "fontSize": 13,
        "icon": "triangle-exclamation"
      },
      "ports": [
        {
          "id": "port-cop03-ot-in-report",
          "label": "Obstacle Report",
          "direction": "in",
          "dataType": "event",
          "position": "top"
        },
        {
          "id": "port-cop03-ot-out-active",
          "label": "Active Obstacles",
          "direction": "out",
          "dataType": "data",
          "position": "bottom"
        },
        {
          "id": "port-cop03-ot-out-index",
          "label": "Obstacle Position Index",
          "direction": "out",
          "dataType": "data",
          "position": "right"
        }
      ]
    },
    {
      "id": "node-cop03-obstacle-renderer",
      "label": "Obstacle Renderer",
      "type": "component",
      "engineId": "eng-cop-dynamic-obstacles",
      "description": "Renders active dynamic obstacles as styled overlay symbols on the operational picture. Receives the active obstacle list from the Obstacle Tracker, applies configurable symbology based on obstacle type and threat level (e.g., danger zone radius, exclusion area shading, movement vector arrows), and outputs the composed obstacle layer to the Map Renderer for compositing.",
      "position": {
        "x": 860,
        "y": 380
      },
      "size": {
        "width": 230,
        "height": 140
      },
      "style": {
        "backgroundColor": "#2a2210",
        "borderColor": "#f59e0b",
        "borderWidth": 2,
        "borderStyle": "solid",
        "cornerRadius": 8,
        "textColor": "#e2e8f0",
        "fontSize": 13,
        "icon": "eye"
      },
      "ports": [
        {
          "id": "port-cop03-or-in-active",
          "label": "Active Obstacles In",
          "direction": "in",
          "dataType": "data",
          "position": "top"
        },
        {
          "id": "port-cop03-or-out-layer",
          "label": "Obstacle Layer",
          "direction": "out",
          "dataType": "data",
          "position": "right"
        }
      ]
    },
    {
      "id": "node-cop03-spatial-query",
      "label": "Spatial Query Service",
      "type": "component",
      "engineId": "eng-cop-geospatial-data",
      "description": "Provides spatial indexing and query capabilities for all geospatial data managed by the COP. Maintains spatial indexes for imported datasets, geofence geometries, and obstacle positions. Supports point-in-polygon containment tests, nearest-neighbor searches, bounding-box intersection queries, and coordinate reference system transformations. Serves spatial query results to the Geofence Evaluator and other consumers.",
      "position": {
        "x": 480,
        "y": 420
      },
      "size": {
        "width": 230,
        "height": 160
      },
      "style": {
        "backgroundColor": "#0e2e2e",
        "borderColor": "#14b8a6",
        "borderWidth": 2,
        "borderStyle": "solid",
        "cornerRadius": 8,
        "textColor": "#e2e8f0",
        "fontSize": 13,
        "icon": "search-location"
      },
      "ports": [
        {
          "id": "port-cop03-sq-in-index",
          "label": "Index Data",
          "direction": "in",
          "dataType": "data",
          "position": "left"
        },
        {
          "id": "port-cop03-sq-in-query",
          "label": "Spatial Query In",
          "direction": "in",
          "dataType": "data",
          "position": "top"
        },
        {
          "id": "port-cop03-sq-out-result",
          "label": "Query Result Out",
          "direction": "out",
          "dataType": "data",
          "position": "top"
        }
      ]
    },
    {
      "id": "node-cop03-data-io",
      "label": "Data Import/Export Service",
      "type": "component",
      "engineId": "eng-cop-geospatial-data",
      "description": "Handles import and export of geospatial data in standard interchange formats (KML, KMZ, GeoJSON, GeoPackage, Shapefile). Parses imported files, validates geometry and coordinate reference systems, transforms coordinates to the active CRS, registers datasets with the Spatial Query Service for indexing, and produces rendered overlay layers for the Map Renderer. Supports export of mission geofences, tracks, and annotations for debrief and sharing.",
      "position": {
        "x": 480,
        "y": 680
      },
      "size": {
        "width": 230,
        "height": 160
      },
      "style": {
        "backgroundColor": "#0e2e2e",
        "borderColor": "#14b8a6",
        "borderWidth": 2,

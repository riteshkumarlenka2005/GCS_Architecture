    {
      "id": "node-cop03-geofence-store",
      "label": "Geofence Store",
      "type": "database",
      "engineId": "eng-cop-geofence",
      "description": "Persistent storage for geofence definitions, geometry data, classification metadata, and alert history. Supports spatial indexing for efficient geofence retrieval by geographic extent, maintains version history for geofence edits, and provides bulk import/export of geofence sets for mission planning and debrief.",

          "label": "Index Imported Data",
          "direction": "out",
          "dataType": "data",
          "position": "top"
        },
        {
          "id": "port-cop03-dio-out-layer",
          "label": "Geospatial Overlay",
          "direction": "out",
          "dataType": "data",
          "position": "right"
        }

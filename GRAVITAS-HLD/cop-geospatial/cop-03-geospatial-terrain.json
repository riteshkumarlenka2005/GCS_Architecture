  "nodes": [
    {
      "id": "node-cop03-geofence-mgr",
      "label": "Geofence Manager",
      "type": "component",
      "engineId": "eng-cop-geofence",
      "description": "Manages the full lifecycle of geofence definitions: creation, editing, activation, deactivation, and deletion. Supports multiple geofence geometry types (polygon, circle, corridor, altitude band) and classification categories (no-fly zone, restricted area, waypoint boundary, custom). Processes geofence commands from the COP Orchestrator, persists definitions to the Geofence Store, and pushes the active geofence set to the Geofence Evaluator for real-time monitoring.",
      "position": {
        "x": 120,
        "y": 120
      },
      "size": {
        "width": 230,
        "height": 170
      },
      "style": {
        "backgroundColor": "#2a1a1e",
        "borderColor": "#ef4444",
        "borderWidth": 2,
        "borderStyle": "solid",
        "cornerRadius": 8,
        "textColor": "#e2e8f0",
        "fontSize": 13,
        "icon": "draw-polygon"
      },
      "ports": [
        {
          "id": "port-cop03-gm-in-cmd",
          "label": "Geofence Command",
          "direction": "in",
          "dataType": "control",
          "position": "top"
        },
        {
          "id": "port-cop03-gm-out-active",
          "label": "Active Geofences",
          "direction": "out",
          "dataType": "data",
          "position": "right"
        },
        {
          "id": "port-cop03-gm-out-persist",
          "label": "Persist Geofence",
          "direction": "out",
          "dataType": "data",
          "position": "bottom"
        },
        {
          "id": "port-cop03-gm-in-load",
          "label": "Loaded Geofences",
          "direction": "in",
          "dataType": "data",
          "position": "bottom"
        },
        {
          "id": "port-cop03-gm-out-index",
          "label": "Geofence Geometry Index",
          "direction": "out",
          "dataType": "data",
          "position": "right"
        }
      ]
    },
    {
      "id": "node-cop03-geofence-eval",
      "label": "Geofence Evaluator",
      "type": "component",
      "engineId": "eng-cop-geofence",
      "description": "Performs real-time evaluation of vehicle positions against all active geofences. Ingests vehicle position streams from the Vehicle State Store, tests containment and proximity using the Spatial Query Service for complex polygon geometries, detects entry/exit/proximity threshold events, and publishes geofence alerts to the Core Event Bus for operator notification and downstream safety policy enforcement.",
      "position": {
        "x": 480,
        "y": 120
      },
      "size": {
        "width": 230,
        "height": 170
      },
      "style": {
        "backgroundColor": "#2a1a1e",
        "borderColor": "#ef4444",
        "borderWidth": 2,
        "borderStyle": "solid",
        "cornerRadius": 8,
        "textColor": "#e2e8f0",
        "fontSize": 13,
        "icon": "shield-alert"
      },
      "ports": [
        {
          "id": "port-cop03-ge-in-active",
          "label": "Active Geofences In",
          "direction": "in",
          "dataType": "data",
          "position": "left"
        },
        {
          "id": "port-cop03-ge-in-positions",
          "label": "Vehicle Positions",
          "direction": "in",
          "dataType": "data",
          "position": "top"
        },
        {
          "id": "port-cop03-ge-out-query",

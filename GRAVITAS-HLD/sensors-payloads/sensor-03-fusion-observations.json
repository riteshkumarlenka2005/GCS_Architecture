    "nodes": [
        {
            "nodeId": "node-s03-coverage-planner",
            "label": "Coverage Planner",
            "type": "component",
            "description": "Plans sensor coverage paths to maximize area coverage or target observation. Generates optimized waypoints using configurable patterns (lawnmower, spiral, radial) based on sensor FOV, terrain elevation, vehicle kinematics, and mission objectives. Integrates with mission planning for waypoint injection and with data quality for re-acquisition gap filling. Coverage products must identify the target geometry, planned versus observed coverage state, coordinate reference, terrain/model version, and required resolution/overlap so gaps are computed against the actual mission objective.",
            "position": {
                "x": 160,
                "y": 260
            },
            "size": {
                "width": 300,
                "height": 220
            },
            "style": {
                "fill": "#ec4899",
                "stroke": "#be185d",
                "strokeWidth": 2,
                "cornerRadius": 6,
                "icon": "grid"
            },
            "engines": [
                "eng-sensor-coverage-planning"
            ],
            "ports": [
                {
                    "portId": "port-s03-covplan-in-coverage-req",

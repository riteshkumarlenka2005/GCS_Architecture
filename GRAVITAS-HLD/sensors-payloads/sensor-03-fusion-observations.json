        {
            "nodeId": "node-s03-quality-monitor",
            "label": "Data Quality Monitor",
            "type": "component",
            "description": "Monitors and assesses sensor data quality in real-time. Detects degraded imagery (blur, overexposure, underexposure), sensor noise anomalies, data dropouts, and timestamp gaps. Produces normalized quality scores per observation, triggers re-acquisition requests when quality falls below configurable thresholds, and emits alerts for operator awareness. Quality results must retain observation identifiers, sensor identifiers, capture timestamps, coordinate frame, calibration version, provenance, and uncertainty so annotations and re-acquisition decisions remain auditable.",
            "position": {
                "x": 720,
                "y": 260
            },
            "size": {
                "width": 300,
                "height": 220
            },
            "style": {

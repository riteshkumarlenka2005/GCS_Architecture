    "assumptions": [
        {
            "assumptionId": "AS-089",
            "description": "Coverage planning patterns (lawnmower, spiral, radial) are pre-defined with configurable parameters (overlap percentage, line spacing, altitude); custom patterns are supported via the plugin extension engine.",
            "rationale": "Standard survey patterns cover the majority of operational use cases; plugin support provides extensibility without core changes."
        },
        {
            "assumptionId": "AS-090",
            "description": "Data quality scoring uses a normalized 0.0–1.0 scale with configurable thresholds per sensor type and modality. Scores below the rejection threshold trigger automatic re-acquisition; scores below the warning threshold generate operator alerts.",
            "rationale": "Normalized scoring enables consistent cross-sensor comparison and configurable policy enforcement without hard-coded values."
        },
        {
            "assumptionId": "AS-091",
            "description": "Coverage and observation geometry use an explicitly declared coordinate reference and frame; transformations are versioned and time-aligned with vehicle pose and sensor calibration.",
            "rationale": "Coverage overlap, terrain projection, and re-acquisition targeting are invalid if frame or timestamp provenance is ambiguous."
        },
        {
            "assumptionId": "AS-092",
            "description": "Quality annotations are associated with observations by stable identifiers and are stored separately from immutable raw sensor payloads.",
            "rationale": "This preserves source evidence and supports repeatable downstream filtering and audit."
        },
        {
            "assumptionId": "AS-093",
            "description": "Re-acquisition requests are advisory planning inputs; mission safety constraints, vehicle feasibility, and operator authorization remain enforced by the planning and mission execution subsystems.",
            "rationale": "A data-quality trigger must not directly bypass mission validation or command authorization."
        },
        {
            "assumptionId": "AS-094",
            "description": "The quality monitor can evaluate both raw and fused observations, but modality-specific metrics and thresholds are configured per sensor type.",
            "rationale": "A single universal image-quality metric is not valid for every sensor modality."
        }
    ],
    "unresolvedDecisions": [
        {
            "decisionId": "UD-089",
            "description": "Coverage planning optimization algorithm selection: greedy sweep vs genetic algorithm vs A*-variant with coverage heuristic. Trade-off between computation time and coverage optimality for large areas.",
            "options": [
                "Greedy sweep (fast, suboptimal)",
                "Genetic algorithm (slow, near-optimal)",
                "A*-variant with coverage heuristic (balanced)"
            ],
            "impact": "Affects planning latency for large survey areas and coverage completeness percentage."
        },
        {
            "decisionId": "UD-090",
            "description": "Data quality metric weighting scheme: relative importance of sharpness, exposure, noise floor, completeness, and timestamp continuity in the composite quality score.",
            "options": [
                "Equal weighting",
                "Configurable per-sensor weighting",
                "ML-derived weighting from historical data"
            ],
            "impact": "Affects which observations are flagged for re-acquisition and overall mission data yield."
        },
        {
            "decisionId": "UD-091",
            "description": "Define the re-acquisition request contract and arbitration policy when multiple low-quality observations map to overlapping targets or conflict with existing mission priorities.",
            "options": [
                "Deduplicate by target/footprint and merge priorities",
                "Preserve each observation request independently",
                "Delegate arbitration to the mission planner"
            ],
            "impact": "Affects duplicate task generation, mission churn, prioritization, and operator predictability."
        },
        {
            "decisionId": "UD-092",
            "description": "Define the quality-score lifecycle for asynchronous or late-arriving fused observations, including whether a later score may revise an earlier observation disposition.",
            "options": [
                "Immutable first score with later supplemental assessments",
                "Versioned score revisions with explicit supersession",
                "Windowed finalization after a configurable lateness bound"
            ],
            "impact": "Affects reproducibility, downstream filtering, and re-acquisition timing."
        },
        {
            "decisionId": "UD-093",
            "description": "Define bounded processing and backpressure behavior when sensor frame rates exceed quality-monitor capacity.",
            "options": [
                "Prioritized sampling with explicit dropped-frame accounting",
                "Bounded queue with configurable degradation policy",
                "Adaptive metric reduction under load"
            ],
            "impact": "Affects latency, data completeness, resource use, and quality-alert reliability."
        }
    ],

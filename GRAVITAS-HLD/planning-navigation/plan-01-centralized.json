  "assumptions": [
    {
      "id": "AS-039",
      "description": "Planning mode selection is evaluated periodically and on connectivity-change events, with a configurable hysteresis to prevent rapid mode oscillation.",
      "rationale": "Frequent mode switching would destabilize planning and confuse operators; hysteresis ensures stable mode selection."
    },
    {
      "id": "AS-040",
      "description": "The Centralized Planner and Decentralized Planner share a common plan representation format so that the Hybrid Coordinator can merge partial plans from both modes.",
      "rationale": "Plan merging requires a common schema; the specific format is an implementation detail."
    },
    {
      "id": "AS-041",
      "description": "Motion model parameters are updated when vehicle configuration changes (e.g., payload drop, battery swap) and the Motion Model Engine is notified via vehicle state events.",
      "rationale": "Motion constraints change with vehicle configuration; stale parameters would produce infeasible plans."
    },
    {
      "id": "AS-042",
      "description": "The planning computation cycle time is bounded and configurable, with the Hybrid Coordinator selecting the planning mode that can meet the required cycle time for the current operational tempo.",
      "rationale": "Real-time planning requires bounded computation; centralized planning is slower but more optimal, decentralized is faster but locally optimal."
    }
  ],
  "unresolvedDecisions": [

    {
      "id": "node-plan01-hybrid",
      "label": "Hybrid Planning Coordinator",
      "type": "component",
      "engineId": "eng-plan-hybrid",
      "description": "Orchestrates the planning mode lifecycle and coordinates between centralized and decentralized planning. Evaluates operational context (vehicle count, network connectivity, mission criticality, latency requirements) to select the optimal planning mode. Delegates planning tasks to the Centralized Planner when full network connectivity is available, falls back to the Decentralized Planner when connectivity is degraded, and merges partial plans from both modes during hybrid operation. Publishes mode-transition events and the unified plan output to the Core Event Bus for downstream execution and visualization.",
      "position": {
        "x": 380,
        "y": 80
      },
      "size": {
        "width": 260,
        "height": 190
      },

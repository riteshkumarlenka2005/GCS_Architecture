    {
      "id": "node-plan01-motion",
      "label": "Motion Model Engine",
      "type": "component",
      "engineId": "eng-plan-motion-model",
      "description": "Provides vehicle kinematic and dynamic motion models that constrain all planning computations. Maintains a library of parameterized motion models for each supported vehicle type (fixed-wing, multirotor, ground vehicle, etc.) including turn radius, climb/descent rate, acceleration limits, and velocity envelopes. Responds to motion feasibility queries from the Centralized and Decentralized Planners, returning the set of kinematically and dynamically achievable trajectories for a given vehicle state and control input range. Motion model parameters are configurable per vehicle instance to account for payload, battery state, and environmental conditions.",
      "position": {
        "x": 380,
        "y": 660
      },
      "size": {
        "width": 260,
        "height": 160
      },

    {
      "id": "node-plan01-decentralized",
      "label": "Decentralized Planner",
      "type": "component",
      "engineId": "eng-plan-decentralized",
      "description": "Computes plans locally on each vehicle or in peer-to-peer planning groups without requiring a central authority. Receives planning delegations from the Hybrid Coordinator, uses locally available vehicle state and sensor data, queries the Motion Model Engine for vehicle-specific constraints, and produces locally optimal plans that are shared with peer planners for coordination. Designed for degraded-connectivity scenarios, single-vehicle operations, and latency-critical reactive planning where waiting for centralized computation is unacceptable.",

    {
      "id": "node-plan01-centralized",
      "label": "Centralized Planner",
      "type": "component",
      "engineId": "eng-plan-centralized",
      "description": "Computes optimal plans for all vehicles from a single planning authority with full global state visibility. Receives planning delegations from the Hybrid Coordinator, ingests current vehicle states from the Vehicle State Store, queries the Motion Model Engine for kinematic and dynamic constraints, and produces globally optimized plans that account for all vehicles simultaneously. Best suited for scenarios with reliable high-bandwidth connectivity and moderate vehicle fleet sizes where global optimality is preferred over planning latency.",
      "position": {
        "x": 80,
        "y": 380
      },
      "size": {
        "width": 240,
        "height": 170
      },

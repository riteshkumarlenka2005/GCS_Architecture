    {
      "id": "node-plan02-reactive",
      "label": "Reactive Avoidance Controller",
      "type": "component",
      "engineId": "eng-plan-reactive-avoidance",
      "description": "Provides the lowest-latency layer of the planning hierarchy for real-time collision avoidance. Continuously monitors the vehicle's immediate surroundings for imminent collision threats using sensor-derived obstacle data from the Core Event Bus. When a threat is detected within the reactive safety envelope, the Reactive Avoidance Controller computes an immediate evasive maneuver constrained by the Motion Model Engine's maximum dynamic capabilities, overrides the current plan segment with the avoidance maneuver, and signals the Local Replanner to compute a new local route once the threat is cleared. Operates at the highest update rate in the planning stack.",
      "position": {
        "x": 120,
        "y": 520
      },
      "size": {
        "width": 250,
        "height": 180
      },

  "assumptions": [
    {
      "id": "AS-043",
      "description": "The planning hierarchy operates at three distinct time scales: global route (seconds to minutes), local replan (hundreds of milliseconds to seconds), and reactive avoidance (tens of milliseconds).",
      "rationale": "Layered planning ensures that slow global optimization does not block fast reactive responses; each layer has bounded computation time."
    },
    {
      "id": "AS-044",
      "description": "The Reactive Avoidance Controller can override the active plan segment without waiting for Local Replanner or Hybrid Coordinator approval, with post-maneuver reconciliation handled asynchronously.",
      "rationale": "Collision avoidance is safety-critical and cannot tolerate the latency of higher-level planning approval."
    },
    {
      "id": "AS-045",
      "description": "Terrain traversability data is available at a resolution sufficient for route planning (e.g., 10–30 m grid) and is updated when new terrain data is ingested by the COP.",
      "rationale": "Route planning requires terrain data at a scale commensurate with vehicle maneuverability; the specific resolution is a deployment decision."
    },
    {
      "id": "AS-046",
      "description": "The Local Replanner's deviation threshold is configurable per mission and vehicle type, with tighter thresholds for precision operations and looser thresholds for transit flights.",
      "rationale": "Different mission phases have different tolerance for route deviation; a single fixed threshold would be inappropriate."
    }
  ],
  "unresolvedDecisions": [
    {
      "id": "UD-046",
      "description": "Global route planning algorithm and search space discretization (e.g., grid-based A*, visibility graph, sampling-based RRT*).",
      "impact": "Affects route optimality, computation time, and scalability to large operational areas.",
      "owner": "Planning Architecture"
    },
    {
      "id": "UD-047",
      "description": "Local replanning trigger thresholds: cross-track deviation distance, along-track timing error, and obstacle proximity distance.",
      "impact": "Affects Local Replanner's sensitivity and the frequency of route repairs.",
      "owner": "Operations Architecture"
    },
    {
      "id": "UD-048",
      "description": "Reactive avoidance safety envelope size and the time-to-collision threshold for evasive maneuver activation.",
      "impact": "Affects Reactive Avoidance Controller's activation timing and the trade-off between false positives and collision risk.",
      "owner": "Safety Architecture"
    },
    {
      "id": "UD-049",
      "description": "Route rejoin strategy after local replanning or reactive avoidance: nearest-point rejoin, next-waypoint rejoin, or full re-route.",
      "impact": "Affects plan continuity and the computational cost of post-deviation recovery.",
      "owner": "Planning Architecture"
    }
  ],

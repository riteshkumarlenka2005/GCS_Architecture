  "nodes": [
    {
      "id": "node-plan02-global-router",
      "label": "Global Route Planner",
      "type": "component",
      "engineId": "eng-plan-global-route",
      "description": "Computes end-to-end routes from origin to destination across the operational area. Ingests mission objectives from the Hybrid Planning Coordinator, queries terrain traversability data from the COP Terrain Processor, incorporates geofence and no-fly-zone constraints from the COP Orchestrator, and evaluates candidate routes against vehicle motion constraints from the Motion Model Engine. Produces a globally optimal route as an ordered sequence of waypoints with associated altitude, speed, and heading constraints. Supports multi-objective route optimization balancing distance, energy, time, and risk.",
      "position": {
        "x": 120,
        "y": 120
      },
      "size": {
        "width": 250,
        "height": 190
      },
      "style": {
        "backgroundColor": "#2a2210",
        "borderColor": "#f59e0b",
        "borderWidth": 2,
        "borderStyle": "solid",
        "cornerRadius": 8,
        "textColor": "#e2e8f0",
        "fontSize": 13,
        "icon": "route"
      },

    {
      "id": "node-plan02-waypoint-opt",
      "label": "Waypoint Optimizer",
      "type": "component",
      "engineId": "eng-plan-global-route",
      "description": "Refines the global route produced by the Global Route Planner through waypoint placement optimization, ordering, and smoothing. Eliminates redundant waypoints, adjusts waypoint spacing based on vehicle turn radius and terrain complexity, applies altitude and speed profile optimization along the route, and ensures all waypoints satisfy vehicle kinematic constraints. Outputs the final optimized waypoint sequence to the Local Replanner for execution monitoring and to the Hybrid Coordinator for plan integration.",
      "position": {
        "x": 500,
        "y": 120
      },
      "size": {
        "width": 230,
        "height": 170
      },
      "style": {
        "backgroundColor": "#2a2210",
        "borderColor": "#f59e0b",
        "borderWidth": 2,
        "borderStyle": "solid",
        "cornerRadius": 8,
        "textColor": "#e2e8f0",
        "fontSize": 13,
        "icon": "bezier-curve"
      },
      "ports": [
        {
          "id": "port-plan02-wo-in-route",
          "label": "Raw Global Route",
          "direction": "in",
          "dataType": "data",
          "position": "left"
        },
        {
          "id": "port-plan02-wo-out-optimized",
          "label": "Optimized Waypoints",
          "direction": "out",
          "dataType": "data",
          "position": "right"
        },
        {
          "id": "port-plan02-wo-out-to-replan",
          "label": "Route to Replanner",
          "direction": "out",
          "dataType": "data",
          "position": "bottom"
        }
      ]
    },
    {
      "id": "node-plan02-local-replanner",
      "label": "Local Replanner",
      "type": "component",
      "engineId": "eng-plan-local-replan",
      "description": "Monitors active plan execution against the optimized global route and triggers local replanning when deviations exceed configurable thresholds or when new obstacles and constraints are detected. Compares actual vehicle position from the Vehicle State Store against the planned route, evaluates deviation magnitude and trend, queries the Motion Model Engine for feasible local detours, and produces a repaired local route segment that reconnects to the global route at the nearest feasible rejoin point. Publishes replan events to the Core Event Bus for operator awareness.",
      "position": {
        "x": 500,
        "y": 420
      },
      "size": {
        "width": 250,
        "height": 190
      },

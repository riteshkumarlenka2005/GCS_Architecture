        "responsibilities": [
          "Receive classified loss notifications and open recovery sessions",
          "Apply configurable retry and backoff policies per channel and loss class",
          "Serialize attempts to avoid reconnect storms",
          "Coordinate with Routing Engine to select alternative paths",
          "Instruct Transport Abstraction Engine to re-establish channels",
          "Emit recovery progress and outcome events"
        ],
        "inputs": [
          "Loss notifications and classifications from detector",
          "Recovery policy configuration",
          "Route advisories from Routing Engine"
        ],
        "outputs": [
          "Reconnect attempt commands to transport layer",
          "Recovery status events to the event bus"
        ],
        "constraints": [
          "Backoff must bound attempt rate under sustained failure",
          "Recovery must not block the main transport loop",
          "Recovery must preserve buffered data where possible (req-GA-005)"
        ],
        "failureModes": [
          "Reconnect storm",
          "Backoff too aggressive causing delayed recovery",
          "Policy misconfiguration"
        ],
        "technologyNotes": null,
        "assumptions": [],
        "unresolvedDecisions": [

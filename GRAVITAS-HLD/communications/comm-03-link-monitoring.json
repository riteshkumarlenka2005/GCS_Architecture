  "assumptions": [
    {
      "id": "AS-002",
      "description": "All engines are logical components. Separate processes or services are not assumed unless explicitly stated.",
      "impact": "Recovery and routing components are co-located within the comm subsystem."
    },
    {
      "id": "AS-010",
      "description": "Network interfaces are managed by the host OS and accessed through the Multi-Network Manager.",
      "impact": "Routing selects logical paths; realization uses interfaces managed by Multi-Network Manager."
    },
    {
      "id": "AS-012",
      "description": "Route table state is runtime in-memory; persistence applies to snapshots for audit, not live routing decisions.",
      "impact": "Route Table failure requires rebuild from Routing Engine state; snapshots support post-incident review."
    }

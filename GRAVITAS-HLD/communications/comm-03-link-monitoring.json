        ],
        "constraints": [
          "Must avoid false positives under transient fluctuations",
          "Must distinguish confirmed loss from suspected loss (req-GA-006)"
        ],
        "failureModes": [
          "Missed loss on silent-failure channels",
          "Over-sensitive triggering causing recovery storms"
        ],

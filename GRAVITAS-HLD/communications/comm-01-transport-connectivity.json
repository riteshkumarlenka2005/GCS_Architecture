        "responsibilities": [
          "Provide uniform send/receive API to all subsystems",
          "Abstract underlying transport protocols (UDP, TCP, serial, etc.)",
          "Handle data framing, segmentation, and reassembly",
          "Manage connection lifecycle (open, maintain, close)",
          "Buffer outbound data during transient disconnections",
          "Report channel status and throughput metrics"
        ],
        "inputs": [
          "Outbound data and commands from all subsystems",
          "Inbound raw packets from network interfaces"
        ],
        "outputs": [
          "Framed packets to network interfaces",
          "Reassembled inbound data to subsystems",
          "Channel status events"
        ],
        "constraints": [
          "Must support multiple concurrent transport channels",
          "Must handle variable latency and bandwidth (req-2.2-007)",
          "Must buffer data during transient link loss (req-GA-005)"
        ],
        "failureModes": [
          "Channel deadlock",
          "Buffer overflow",
          "Protocol mismatch"
        ],
        "technologyNotes": null,
        "assumptions": [
          "AS-002: Logical component within comm subsystem"
        ],
        "unresolvedDecisions": [
          "UD-001: Specific communication protocols not named"
        ],
        "notes": "Canonical engine: eng-comm-transport"
      }

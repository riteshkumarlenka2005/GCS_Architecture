  "assumptions": [
    {
      "id": "AS-001",
      "description": "GCS operates in local-first mode. Network connectivity to vehicles and remote systems may be intermittent.",
      "impact": "Transport layer must buffer data and multi-network manager must handle zero-interface states gracefully."
    },
    {
      "id": "AS-002",
      "description": "All engines are logical components. Separate processes or services are not assumed.",
      "impact": "Transport and multi-network components are co-located within the comm subsystem."
    },
    {
      "id": "AS-010",
      "description": "Network interfaces are assumed to be managed by the host OS. The GCS accesses them through standard OS APIs.",
      "impact": "Interface pool does not implement raw hardware drivers; it relies on platform runtime abstraction."
    }
  ],

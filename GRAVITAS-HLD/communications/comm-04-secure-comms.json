    "assumptions": [
        {
            "id": "AS-013",
            "description": "Cryptographic algorithm selection is deployment-configurable and abstracted behind the Crypto Engine interface; the architecture does not mandate specific cipher suites.",
            "rationale": "Requirements specify secure communications but do not prescribe algorithms; deployment environments may have regulatory or certification constraints."
        },
        {
            "id": "AS-014",
            "description": "Key storage is provided by the host platform's secure storage facilities (e.g., OS keychain, TPM, secure enclave) and accessed through a platform abstraction layer.",
            "rationale": "Key storage mechanism is platform-dependent; the Key Lifecycle Manager abstracts this behind a uniform interface."
        },
        {
            "id": "AS-015",
            "description": "Secure session resumption after network reconnection reuses the existing security context where the session has not expired, avoiding full re-authentication overhead.",
            "rationale": "Performance requirement for rapid reconnection; full re-authentication occurs only when session context is invalidated."
        },
        {
            "id": "AS-016",
            "description": "The Security subsystem's Authentication engine (doc-sec-01) provides a synchronous or asynchronous identity-verification API that the Endpoint Authenticator can invoke during session handshake.",
            "rationale": "Cross-subsystem integration pattern; exact API contract is an implementation detail."
        }
    ],
    "unresolvedDecisions": [
        {
            "id": "UD-018",
            "description": "Specific cryptographic algorithms and cipher suites for data-in-transit protection (e.g., AES-256-GCM, ChaCha20-Poly1305, or others).",
            "impact": "Affects Crypto Engine configuration and performance characteristics; does not change the architectural structure.",
            "owner": "Security Architecture"
        },
        {
            "id": "UD-019",
            "description": "Key management infrastructure: hardware security module (HSM), software key store, cloud KMS, or platform-native secure storage.",
            "impact": "Affects Key Lifecycle Manager's storage backend and key-generation capabilities.",
            "owner": "Deployment Architecture"
        },
        {
            "id": "UD-020",
            "description": "Certificate authority and PKI infrastructure for endpoint certificates: self-signed, private CA, or public CA.",
            "impact": "Affects Endpoint Authenticator's certificate-chain validation logic and Key Lifecycle Manager's certificate provisioning.",
            "owner": "Security Architecture"
        },
        {
            "id": "UD-021",
            "description": "Secure session protocol framing: TLS 1.3, DTLS 1.3, or a custom secure framing layer atop the Transport Abstraction.",
            "impact": "Affects the interface contract between Session Manager and Transport Abstraction Engine.",
            "owner": "Communications Architecture"
        },

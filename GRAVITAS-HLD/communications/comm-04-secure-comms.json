        {
            "requirementId": "req-2.4-07",
            "description": "The system shall establish secure communication channels with authenticated endpoints before exchanging command or telemetry data.",
            "coveredByNodes": [
                "node-comm04-session-manager",
                "node-comm04-endpoint-authenticator"

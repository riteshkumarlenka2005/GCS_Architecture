    "nodes": [
        {
            "id": "node-comm04-session-manager",
            "label": "Secure Session Manager",
            "type": "component",
            "engineId": "eng-comm-secure-comms",
            "description": "Orchestrates the full secure session lifecycle: establishment, negotiation, maintenance, suspension, resumption, and termination. Coordinates with the Crypto Engine for encrypt/decrypt operations, delegates endpoint authentication, enforces security policy before session creation, and publishes security-relevant events. Acts as the primary integration point with the Transport Abstraction layer below and the Connection Recovery engine for session continuity across network transitions. Inbound frames must not be released to downstream consumers until decryption, integrity/authentication verification, and replay-window checks have succeeded. Outbound frames must be protected before they are handed to Transport.",
            "position": {
                "x": 240,
                "y": 260
            },
            "size": {
                "width": 230,
                "height": 170
            },
            "style": {
                "backgroundColor": "#0e3a4f",
                "borderColor": "#06b6d4",
                "borderWidth": 2,
                "borderStyle": "solid",
                "cornerRadius": 8,
                "textColor": "#e2e8f0",
                "fontSize": 13,
                "icon": "shield-check"
            },

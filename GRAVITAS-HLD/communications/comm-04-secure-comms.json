        {
            "id": "node-comm04-key-lifecycle",
            "label": "Key & Certificate Lifecycle Manager",
            "type": "component",
            "engineId": "eng-comm-secure-comms",
            "description": "Manages the full lifecycle of cryptographic keys and certificates used for secure communications: generation, secure storage, distribution to active sessions, periodic rotation, and revocation. Provides key material to the Cryptographic Engine on demand and pushes rotation events when keys are refreshed. Validates certificate chains and credential material on behalf of the Endpoint Authenticator. The underlying key-storage mechanism and PKI infrastructure are deployment-specific and abstracted behind this component's interface. Key rotation must define an activation point, overlap/grace handling for in-flight frames, retirement of superseded keys, and failure reporting so active sessions are not silently left in an indeterminate key state.",
            "position": {
                "x": 930,
                "y": 140
            },
            "size": {
                "width": 220,
                "height": 150
            },
            "style": {
                "backgroundColor": "#0c3547",
                "borderColor": "#06b6d4",
                "borderWidth": 2,
                "borderStyle": "solid",
                "cornerRadius": 8,
                "textColor": "#e2e8f0",
                "fontSize": 13,
                "icon": "key"
            },
            "ports": [
                {
                    "id": "port-comm04-kl-in-key-req",
                    "label": "Key/Cert Request In",
                    "direction": "in",
                    "dataType": "data",
                    "position": "left"
                },
                {
                    "id": "port-comm04-kl-out-key-rotate",
                    "label": "Key Rotation Out",
                    "direction": "out",
                    "dataType": "event",
                    "position": "left"
                }
            ]
        },
        {
            "id": "node-comm04-policy-enforcer",
            "label": "Security Policy Enforcer",
            "type": "component",
            "engineId": "eng-comm-secure-comms",
            "description": "Evaluates security policy rules governing secure communications: permitted session parameters, acceptable authentication methods, minimum security levels for different data classifications, and communication-path restrictions. Receives policy-check requests from the Secure Session Manager before session establishment and pushes authentication policy rules to the Endpoint Authenticator. Policy rules are sourced from the GCS configuration layer and may be updated at runtime.",
            "position": {
                "x": 240,
                "y": 560
            },
            "size": {

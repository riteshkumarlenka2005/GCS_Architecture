            "coverageStatus": "fully-mapped",
            "verificationMethod": "analysis",
            "notes": "Session Manager orchestrates establishment; Endpoint Authenticator verifies identity before channel is opened."
        },
        {
            "requirementId": "req-2.4-08",
            "description": "The system shall encrypt all command and telemetry data in transit across all network interfaces.",
            "coveredByNodes": [
                "node-comm04-crypto-engine",

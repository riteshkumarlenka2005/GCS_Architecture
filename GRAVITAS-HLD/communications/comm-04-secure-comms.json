        {
            "id": "node-comm04-crypto-engine",
            "label": "Cryptographic Engine",
            "type": "component",
            "engineId": "eng-comm-secure-comms",
            "description": "Performs all cryptographic operations on data in transit: symmetric encryption and decryption, message authentication code generation and verification, replay-window tracking, and nonce/sequence management. Retrieves active session keys from the Key Lifecycle Manager and reacts to key-rotation events. Abstracts algorithm selection behind a configurable interface so that specific cipher suites are deployment decisions, not architectural ones. A failed integrity check, authentication-code verification, or replay-window check must reject the frame and return a failure result; it must never be treated as valid plaintext.",
            "position": {
                "x": 600,
                "y": 140
            },
            "size": {
                "width": 210,
                "height": 150
            },
            "style": {
                "backgroundColor": "#0c3547",
                "borderColor": "#06b6d4",
                "borderWidth": 2,
                "borderStyle": "solid",
                "cornerRadius": 8,
                "textColor": "#e2e8f0",
                "fontSize": 13,
                "icon": "lock"
            },
            "ports": [
                {
                    "id": "port-comm04-ce-in-req",
                    "label": "Crypto Request In",
                    "direction": "in",
                    "dataType": "control",
                    "position": "left"
                },
                {
                    "id": "port-comm04-ce-out-resp",
                    "label": "Crypto Response Out",
                    "direction": "out",
                    "dataType": "data",
                    "position": "left"
                },
                {
                    "id": "port-comm04-ce-out-key-req",
                    "label": "Key Request",
                    "direction": "out",
                    "dataType": "data",
                    "position": "right"
                },
                {

        {
            "id": "node-comm04-endpoint-authenticator",
            "label": "Endpoint Authenticator",
            "type": "component",
            "engineId": "eng-comm-secure-comms",
            "description": "Authenticates remote endpoints (vehicles, ground stations, peer GCS instances) during session establishment and re-authentication events. Validates presented credentials against the Key Lifecycle Manager and delegates identity verification to the Security subsystem's Authentication engine. Enforces authorization policy rules received from the Policy Enforcer to determine whether an authenticated endpoint is permitted to establish or continue a session.",
            "position": {

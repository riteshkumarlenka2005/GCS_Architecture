          "req-2.2-007",
          "req-2.3-014"
        ],
        "responsibilities": [
          "Sample per-link raw metrics at configurable intervals",
          "Normalize vendor-specific signal metrics to a common schema",
          "Timestamp and tag samples by interface and remote endpoint",
          "Forward raw and normalized metrics to the quality scorer",
          "Expose per-link quality metric streams to diagnostics"
        ],
        "inputs": [
          "Raw interface samples from Network Interface Pool",
          "Channel status from Transport Abstraction Engine"
        ],
        "outputs": [
          "Normalized quality metrics",
          "Per-link quality sample stream to scorer"
        ],
        "constraints": [
          "Sampling must not impose significant network overhead",
          "Must function with heterogeneous interface types"
        ],
        "failureModes": [
          "Sample loss under load",
          "Interface metric unavailability",
          "Timestamp skew"
        ],
        "technologyNotes": null,
        "assumptions": [

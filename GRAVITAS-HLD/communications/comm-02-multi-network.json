        "responsibilities": [
          "Compute composite link health scores from metrics",
          "Classify link state against configurable thresholds",
          "Emit link state transition events (healthy ↔ degraded ↔ poor ↔ failed)",
          "Tag scores with explicit uncertainty when samples are sparse"
        ],
        "inputs": [
          "Normalized quality sample stream from monitor"
        ],
        "outputs": [
          "Link health scores to multi-network selection, diagnostics, and routing",
          "Link state change events"
        ],
        "constraints": [
          "Thresholds must be runtime-configurable",
          "Scoring must distinguish confirmed vs. estimated/uncertain state (req-GA-006)"
        ],
        "failureModes": [
          "Threshold flapping",
          "Score drift under sample loss"
        ],

  "assumptions": [
    {
      "id": "AS-002",
      "description": "All engines are logical components. Separate processes or services are not assumed unless explicitly stated.",
      "impact": "Monitoring, diagnostics, and bandwidth analysis components are co-located within the comm subsystem."
    },
    {
      "id": "AS-010",
      "description": "Network interfaces are managed by the host OS. The GCS accesses them through standard OS APIs.",
      "impact": "Quality and traffic samples depend on metrics exposed by the Interface Pool via OS interfaces."
    },
    {
      "id": "AS-011",
      "description": "Interface capability metadata (nominal capacity, type) is provided by the Multi-Network Manager; where unknown, estimates are marked uncertain.",
      "impact": "Utilization and forecasting outputs must carry explicit uncertainty for exotic or unidentified interfaces."
    }

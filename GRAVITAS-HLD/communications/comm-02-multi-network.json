        "responsibilities": [
          "Correlate link quality scores, bandwidth metrics, and interface events",
          "Detect network faults (link loss, congestion, high error rate, interface failure)",
          "Classify root causes where possible (RF degradation, congestion, hardware fault)",
          "Emit diagnostic events to the central event bus",
          "Publish periodic network health reports to the data layer",
          "Provide diagnostic queries for operator UI and operations"
        ],
        "inputs": [
          "Link health scores and metrics",
          "Bandwidth utilization metrics",
          "Network interface and topology events"
        ],
        "outputs": [
          "Diagnostic events",
          "Network health reports",
          "Fault classifications to recovery and routing"
        ],
        "constraints": [
          "Must not produce false positives under transient fluctuations",
          "Must distinguish confirmed vs. suspected faults (req-GA-006)"
        ],
        "failureModes": [
          "Correlation window too narrow or wide",
          "Missed low-signal faults",
          "Alert storms"
        ],

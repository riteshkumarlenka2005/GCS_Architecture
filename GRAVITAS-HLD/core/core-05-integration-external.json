  "assumptions": [
    {
      "id": "AS-001",
      "description": "GCS operates in local-first mode. Cloud and remote connectivity are optional enhancements.",
      "impact": "External integration gateway must function in fully offline mode with deferred sync."
    },
    {
      "id": "AS-002",
      "description": "All engines are logical components. Separate processes or services are not assumed.",
      "impact": "Plugin sandbox isolation level is implementation-defined."
    },
    {
      "id": "AS-006",
      "description": "Remote sync endpoint is optional and may not be available in all deployments.",
      "impact": "Cloud synchronization workflows must degrade gracefully when no remote endpoint is configured."
    },
    {
      "id": "AS-009",
      "description": "Plugin isolation level (process, thread, container, or WebAssembly sandbox) is implementation-defined.",
      "impact": "The sandbox component is modeled as a logical boundary; physical isolation mechanism is deferred."
    }
  ],

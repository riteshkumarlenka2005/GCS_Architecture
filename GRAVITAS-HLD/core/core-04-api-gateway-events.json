  "assumptions": [
    {
      "id": "AS-002",
      "description": "All engines are logical components. Separate processes or services are not assumed unless explicitly stated.",
      "impact": "API gateway, event bus, and schema registry are modeled as co-located logical components within the core subsystem."
    },
    {
      "id": "AS-008",
      "description": "The event bus is assumed to support at-least-once delivery semantics.",
      "impact": "Subscribers must be idempotent. Exactly-once delivery is not guaranteed by the bus itself."
    }
